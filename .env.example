# ============================================================
# Student Marks Analyzer — Environment Template
# ============================================================
# Copy this file to `.env` and fill in your real values:
#     copy .env.example .env
# Then edit .env with your actual secrets.
# ============================================================

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here-min-32-chars
REFRESH_SECRET_KEY=your-refresh-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- OTP ----------
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
DEV_MODE_SMS=true

# ---------- Gmail SMTP ----------
# SMTP_USER = your full Gmail address
# SMTP_PASS = 16-character App Password from
#             https://myaccount.google.com/apppasswords
#             (remove the spaces when pasting)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-without-spaces

# ---------- Fast2SMS (optional, for SMS) ----------
# Sign up at https://www.fast2sms.com
FAST2SMS_API_KEY=
