# Student Marks Analyzer — Environment Template
# Copy to .env for local dev. For production, use Render env vars.

# Security
SECRET_KEY=change-me-64-char-random
REFRESH_SECRET_KEY=change-me-different-64-char-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Local: leave empty (uses SQLite)
# Production: Neon PostgreSQL URL
DATABASE_URL=

# CORS
CORS_ORIGINS=http://localhost:8501

# Password Policy
PASSWORD_MIN_LENGTH=10
PASSWORD_HISTORY_CHECK=3

# Email (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# SMS (Fast2SMS)
DEV_MODE_SMS=true
FAST2SMS_API_KEY=

# WhatsApp (Twilio — optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# CAPTCHA (Cloudflare Turnstile — optional)
TURNSTILE_SECRET_KEY=

# Files
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=backups
AUTO_BACKUP_HOURS=24

# Misc
WEBSOCKET_ENABLED=true
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
