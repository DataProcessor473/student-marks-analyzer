# ============================================================
# Environment / Secrets — CRITICAL
# ============================================================
# Ignore ALL .env files (contain secrets)
.env
.env.local
.env.*.local
*.env
.env.production
.env.development

# NEVER ignore the template (no secrets, safe to commit)
!.env.example

